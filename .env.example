# Copy to .env. Credentials live only in env vars; never commit .env.

# bi-engine's API, e.g. http://localhost:8000 against docker compose.
BI_ENGINE_URL=
# Shared secret sent to bi-engine as X-Relay-Ingest-Key; must match bi-engine's RELAY_INGEST_KEY.
RELAY_INGEST_KEY=

# The WordPress site running the Surge Quick Quote Leads plugin, e.g. https://www.yoursite.example
WEBSITE_LEADS_SITE_URL=
# The plugin's REST API key (WordPress option surge_qq_leads_rest_api_key), sent as X-Surge-QQ-Leads-Key.
WEBSITE_LEADS_KEY=

# Housecall Pro's public API (no /v1 prefix), and its token, sent as a Bearer; the API needs the Max plan.
HCP_BASE_URL=https://api.housecallpro.com
HCP_API_TOKEN=

# The Search Console property: sc-domain:yoursite.com for a domain property.
SEARCH_CONSOLE_SITE_URL=
# The service account's JSON key file contents, on one line. Add the account's
# client_email as a Restricted user on the property; only the read-only scope is used.
SEARCH_CONSOLE_SERVICE_ACCOUNT_JSON=
